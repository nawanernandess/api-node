generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  email       String  @unique
  phone       String? @unique
  description String? @db.Text
  isUserAdmin Boolean @default(false)
}
